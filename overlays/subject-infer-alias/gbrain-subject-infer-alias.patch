+/** Fact-entity pages whose registered alias occurs as a whole name in the fact. */
+async function aliasSlugsContained(engine: BrainEngine, sourceId: string, fact: string, excludePrivate?: boolean): Promise<string[]> {
+  const privacy = excludePrivate ? `AND ${privatePagesFilterFragment('p')}` : '';
+  const rows = await engine.executeRaw<{ slug: string; type: string | null; alias: string }>(
+    `SELECT p.slug, p.type, COALESCE(a.alias_text, a.alias_norm) AS alias
+       FROM page_aliases a
+       JOIN pages p ON p.source_id = a.source_id AND p.slug = a.slug AND p.deleted_at IS NULL
+      WHERE a.source_id = $1 AND length(COALESCE(a.alias_text, a.alias_norm)) >= 3
+        AND position(lower(COALESCE(a.alias_text, a.alias_norm)) in lower($2)) > 0 ${privacy}`,
+    [sourceId, fact],
+  );
+  const slugs = new Set<string>();
+  for (const row of rows) {
+    if (!row.alias || !isFactEntityPage(row.slug, row.type) || !aliasOccurs(fact, row.alias)) continue;
+    slugs.add(row.slug);
+  }
+  return [...slugs];
+}
