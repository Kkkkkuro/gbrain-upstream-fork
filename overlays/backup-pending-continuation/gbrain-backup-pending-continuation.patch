+/** True when a later tick may finish budget_exhausted remotes without opening a new full sweep. */
+export function pendingBackupContinuationEligible(cached: BackupStatus | null, now = Date.now()): boolean {
+  if (!cached || cached.degraded === true || backupCheckDisabled()) return false;
+  if (isBackupStatusStale(cached, now)) return false;
+  const remoteAge = now - Date.parse(cached.remote_check_at ?? '');
+  if (!Number.isFinite(remoteAge) || remoteAge < 0 || remoteAge > BACKUP_VERIFICATION_MAX_AGE_MS) return false;
+  const cacheAge = now - Date.parse(cached.checked_at);
+  if (!Number.isFinite(cacheAge) || cacheAge < 0) return false;
+  return cached.assets.some((asset) => asset.configured_remote === true
+    && asset.verification?.state === 'budget_exhausted'
+    && asset.verification.attempted_at == null);
