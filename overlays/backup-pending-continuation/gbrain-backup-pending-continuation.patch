+/** One autopilot tick. No-ops unless a fresh cache still has an unattempted budget_exhausted remote. */
+export async function continuePendingBackupOnce(engine: BrainEngine, signal?: AbortSignal): Promise<'skipped' | 'ran'> {
+  if (signal?.aborted || backupCheckDisabled() || !operatingOnHostBrain()) return 'skipped';
+  if (!backupRemoteClaimsAllowContinuation()) {
+    process.stderr.write('[backup] pending continuation refused: remote claims file is unreadable\n');
+    return 'skipped';
+  }
+  if (!pendingBackupContinuationEligible(loadBackupStatus())) return 'skipped';
+  await getBackupStatus(engine, { localGitProbes: true, verifyRemoteRefs: true, pendingOnly: true });
+  return 'ran';
+}
