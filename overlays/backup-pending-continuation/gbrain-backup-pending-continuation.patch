@@ -0,0 +1,68 @@
+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, rmSync, writeFileSync } from 'fs';
+import { tmpdir } from 'os';
+import { join } from 'path';
+import {
+  __setBackupStatusPathForTests,
+  backupRemoteClaimsAllowContinuation,
+  pendingBackupContinuationEligible,
+  type BackupStatus,
+} from '../src/core/backup/status-file.ts';
+
+function status(overrides: Partial<BackupStatus> = {}): BackupStatus {
+  const now = '2026-10-14T00:00:00.000Z';
+  return {
+    schema_version: 'gbrain-backup-status-v2',
+    checked_at: now,
+    remote_check_at: now,
+    gbrain_version: '0.60.187.0',
+    interval_days: 30,
+    computed_by: 'cli',
+    overall: 'warn',
+    totals: { assets: 1, no_remote: 0, unpushed: 0, failing: 1, recoverable_repos: 0, pages_at_risk: 0 },
+    assets: [{
+      kind: 'source_repo',
+      id: 'workspace',
+      state: 'failing',
+      configured_remote: true,
+      verification: { state: 'budget_exhausted', checked_at: now },
+    }],
+    ...overrides,
+  };
+}
+
+describe('pending backup continuation', () => {
+  test('allows an unattempted budget_exhausted remote inside the hour', () => {
+    const now = Date.parse('2026-10-14T00:30:00.000Z');
+    expect(pendingBackupContinuationEligible(status(), now)).toBe(true);
+  });
+
+  test('refuses once remote evidence is older than one hour', () => {
+    const now = Date.parse('2026-10-14T02:00:00.000Z');
+    expect(pendingBackupContinuationEligible(status(), now)).toBe(false);
+  });
+
+  test('refuses a probe that already attempted', () => {
+    const cached = status();
+    cached.assets[0]!.verification!.attempted_at = cached.checked_at;
+    expect(pendingBackupContinuationEligible(cached, Date.parse('2026-10-14T00:30:00.000Z'))).toBe(false);
+  });
+
+  test('missing claims allow continuation and corrupt claims do not', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'gbrain-backup-claims-'));
+    const path = join(dir, 'backup-status.json');
+    __setBackupStatusPathForTests(path);
+    try {
+      expect(backupRemoteClaimsAllowContinuation()).toBe(true);
+      writeFileSync(`${path}.remote-claims`, '{');
+      expect(backupRemoteClaimsAllowContinuation()).toBe(false);
+      writeFileSync(`${path}.remote-claims`, JSON.stringify({
+        generation: 'g', started_at: '2026-10-14T00:00:00.000Z', keys: ['a'],
+      }));
+      expect(backupRemoteClaimsAllowContinuation()).toBe(true);
+    } finally {
+      __setBackupStatusPathForTests(null);
+      rmSync(dir, { recursive: true, force: true });
+    }
+  });
+});
