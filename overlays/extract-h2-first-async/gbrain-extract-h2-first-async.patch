+import { test, expect } from 'bun:test';
+import { PGLiteEngine } from '../src/core/pglite-engine.ts';
+import { configureGateway, resetGateway } from '../src/core/ai/gateway.ts';
+import { exerciseManagedAtomBatch } from '../test/helpers/managed-atoms-contract.ts';
+import { writeFileSync } from 'node:fs';
+
+test('H2: pure terminal conflict replay retains WARN and adds no new H/C/E round', async () => {
+  const engine = new PGLiteEngine();
+  configureGateway({ embedding_model: 'openai:text-embedding-3-large', embedding_dimensions: 1536, env: {} });
+  await engine.connect({}); await engine.initSchema();
+  const events: Array<Array<Record<string, unknown>>> = [];
+  const observed = new Proxy(engine, { get(target, key) {
+    if (key === 'executeRaw') return async (sql: string, params?: unknown[]) => {
+      const result = await target.executeRaw(sql, params);
+      if (sql.includes('INSERT INTO extract_rollup_7d') && params?.includes('atoms-partial-publication')) {
+        events.push(await target.executeRaw("SELECT halt_count,round_completed_count,expected_limit_count,halt_reasons FROM extract_rollup_7d WHERE source_id='atoms-partial-publication'"));
+      }
+      return result;
+    };
+    const value = Reflect.get(target,key); return typeof value === 'function' ? value.bind(target) : value;
+  }});
+  try {
+    await exerciseManagedAtomBatch(observed as never, 'partial_publication');
+    const rows = await engine.executeRaw("SELECT halt_count,round_completed_count,expected_limit_count,halt_reasons FROM extract_rollup_7d WHERE source_id='atoms-partial-publication'");
+    expect(events).toHaveLength(1);
+    expect(events[0]).toMatchObject([{halt_count:1,round_completed_count:0,halt_reasons:{item_error:1}}]);
+    expect(rows).toEqual(events[0]);
+    if (process.env.GBRAIN_TEST_EVIDENCE_PATH) writeFileSync(process.env.GBRAIN_TEST_EVIDENCE_PATH, JSON.stringify({backend:'isolated in-memory PGLite',scenario:'installed exerciseManagedAtomBatch partial_publication',events,final:rows,product_modified:false},null,2));
+  } finally { await engine.disconnect(); resetGateway(); }
+},120000);
